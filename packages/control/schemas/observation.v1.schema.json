{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:3dbox4agent:control:observation:v1",
  "type": "object",
  "required": [
    "tick",
    "self"
  ],
  "properties": {
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "self": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
